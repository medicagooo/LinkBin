  },
  "dependencies": {
    "edgeport": "^1.0.6"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd", "sharp"]
  }
}
