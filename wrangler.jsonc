{
  // LinkBin — Workers configuration.
  //
  // Deployment runs through Cloudflare Workers Builds from the connected GitHub repository
  // (Cloudflare dashboard > Workers & Pages > this Worker > Settings > Build), executing the
  // default `npx wrangler deploy` with this repository as the root directory.
  //
  // RESOURCES ARE AUTO-PROVISIONED. The D1 database and the R2 bucket carry no ids or names on
  // purpose: with none present, Wrangler creates them during the deploy and names them with this
  // Worker's name as a prefix. Deploying from the dashboard (which is what Workers Builds does)
  // creates them but does NOT write their ids back into this file — see README.md.
  // Verified against https://developers.cloudflare.com/workers/wrangler/configuration/ ("Automatic
  // provisioning": currently works for KV, R2, D1, Flagship, AI Search, Agent Memory, Dispatch
  // Namespaces and Queues).
  //
  // SECURITY: this repository is PUBLIC. Never put credentials, host addresses, or internal paths
  // in this file. Hosts and the directories to collect from are runtime DATA: they are added through
  // the web UI and stored encrypted in D1. The only secret this deployment needs is SSH_MASTER_KEY,
  // set in the dashboard or with `wrangler secret put` — never here.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "linkbin",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    // Invocation logs carry CPU time and wall time, which the SSH probe needs as a measurement.
    "enabled": true
  },
  "triggers": {
    // Collection without anyone asking. D42: cron and the manual trigger coexist; cron is weakly delivered and a
    // minute may be skipped, which is why resumability is a requirement and why nothing counts elapsed minutes.
    //
    // EVERY 5 MINUTES, against a spec target of 15-30 minutes freshness. Each invocation collects ONE machine
    // (`planRun` picks the longest-waiting one), so the interval is NOT the per-machine frequency: with N enabled
    // machines each is attempted about every N x 5 minutes. At the 50-host ceiling that is 4 hours per machine,
    // which is exactly why the freshness report exists - it shows the achieved figure against the target rather
    // than assuming the interval delivers it.
    //
    // 5 rather than 15 so a machine that failed is retried before the next full cycle, and so a run that stopped
    // early on its budget resumes sooner.
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // `database_name` pins the name. `database_id` is deliberately ABSENT: Wrangler provisions the
      // database on first deploy, and Cloudflare states the linkage survives later deploys even with
      // no resource ID in this file — so no account-specific ID has to live in a public repository.
      // Source: https://developers.cloudflare.com/changelog/post/2025-10-24-automatic-resource-provisioning/
      // Caveat: with no `database_id`, `wrangler d1 execute|migrations --remote` cannot resolve the
      // database. This project does not need it — the Worker applies its own schema via
      // POST /api/admin/apply-schema. See README.md.
      "database_name": "linkbin-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      // Pinned, not auto-named: the name IS the bucket's identity, so stating it here makes a later
      // deploy bind this bucket rather than provision another one alongside it.
      "bucket_name": "linkbin-files"
    }
  ],
  "rules": [
    {
      // Schema SQL is imported into the Worker as a string so that a deployment with no CLI access
      // can still create its own tables. See src/index.ts, POST /api/admin/apply-schema.
      // `fallthrough` keeps Wrangler's own default text rule in play for the other extensions,
      // instead of silently replacing it.
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true
    }
  ]
}
